# Environment & credentials
# Backend .env has REAL secrets — NEVER commit. Production values live in
# Emergent's secrets manager. Use backend/.env.example as the schema.
backend/.env

# Frontend .env is safe to commit — it only has REACT_APP_BACKEND_URL
# (the public preview URL) and dev-server settings. No secrets.
!frontend/.env

# Allow .env.example files everywhere (they only have placeholders).
!*.env.example
!**/.env.example

credentials.json
*.pem
*.key
.credentials
